# Copy to .env for local testing. On Render, set these as service environment
# variables instead — never commit a real .env file.

# HTTP port. Render sets this automatically; only needed for local runs.
PORT=3000

# Single shared password gating access to this MCP server (Phase 4+).
MCP_SHARED_PASSWORD=

# Turso (libSQL) database connection (Phase 2+).
# Get these from `turso db show <db-name>` and `turso db tokens create <db-name>`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Public HTTPS URL this server is reachable at (Phase 4+).
# Local testing: http://localhost:3000
# Render: https://<your-service>.onrender.com
PUBLIC_BASE_URL=
